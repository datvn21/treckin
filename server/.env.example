# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ─────────────────────────────────────────────────────────────────
# Matches docker-compose.dev.yml (postgres / password / treckin_db).
DATABASE_URL=postgresql://postgres:password@localhost:5432/treckin_db

# ── Redis ────────────────────────────────────────────────────────────────────
# Matches docker-compose.dev.yml.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-me
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── QR ───────────────────────────────────────────────────────────────────────
QR_HMAC_SECRET=your-hmac-secret-key-change-me
QR_TTL_SECONDS=30

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Storage Provider ─────────────────────────────────────────────────────────
# Options: 'local' | 'r2' | 'cloudinary'
STORAGE_PROVIDER=local

# ── Local Storage (when STORAGE_PROVIDER=local) ──────────────────────────────
LOCAL_STORAGE_BASE_URL=http://localhost:4000

# ── Cloudflare R2 (when STORAGE_PROVIDER=r2) ────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=treckin-avatars
R2_PUBLIC_URL=https://your-r2-public-url.com

# ── Cloudinary (when STORAGE_PROVIDER=cloudinary) ────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=