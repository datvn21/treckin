// ============================================================
// Prisma Schema — Treckin
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────

enum USER_ROLE {
  USER
  ADMIN
}

enum EVENT_STATUS {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum BOARD_STATUS {
  ACTIVE
  INACTIVE
  CLOSED
}

enum CHECKIN_METHOD {
  QR_SCAN
  MANUAL
  BULK_SYNC
}

enum ATTENDANCE_POLICY {
  SINGLE_IN
  IN_OUT
  BOARD_REQUIREMENTS
}

enum CHECKIN_DIRECTION {
  IN
  OUT
}

enum CHECKIN_SOURCE {
  PERSONAL_QR
  BOARD_QR
  SHORT_CODE
  MANUAL
  KIOSK
  CSV_IMPORT
  OFFLINE_SYNC
}

enum CHECKIN_MODE {
  ATTENDEE_CREDENTIAL
  BOARD_QR
}

enum EVENT_QR_BEHAVIOR {
  JOIN_ONLY
  JOIN_AND_CHECKIN
}

enum WORKSPACE_MEMBER_ROLE {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum INVITATION_STATUS {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum EVENT_ASSIGNMENT_ROLE {
  MANAGER
  SCANNER
}

enum WORKSPACE_STATUS {
  ACTIVE
  SUSPENDED
  ARCHIVED
  DELETING
}

enum EVENT_VISIBILITY {
  PRIVATE
  WORKSPACE
  PUBLIC_LINK
}

enum DATA_DELETION_MODE {
  PURGE
  ANONYMIZE
}

enum EVENT_TYPE {
  SINGLE_SESSION
  MULTI_SESSION
  OPEN_CHECKIN
}

enum REGISTRATION_MODE {
  CLOSED
  INVITE_ONLY
  WORKSPACE_MEMBERS
  PUBLIC_LINK
  APPROVAL_REQUIRED
}

enum WAITLIST_MODE {
  DISABLED
  AUTO_PROMOTE
  MANUAL
}

enum SESSION_STATUS {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  CANCELLED
}

enum REGISTRATION_STATUS {
  PENDING_APPROVAL
  APPROVED
  WAITLISTED
  REJECTED
  CANCELLED
  CHECKED_IN
  NO_SHOW
}

enum REGISTRATION_SOURCE {
  SELF_JOIN
  INVITE
  IMPORT
  ADMIN_ADD
  API
  WAITLIST_PROMOTION
}

enum FIELD_TYPE {
  TEXT
  LONG_TEXT
  NUMBER
  EMAIL
  PHONE
  DATE
  SELECT
  MULTI_SELECT
  CHECKBOX
  FILE
}

enum CHECKIN_STATUS {
  VALID
  VOIDED
  CORRECTED
  FLAGGED
}

enum CHECKIN_CORRECTION_ACTION {
  VOID
  RESTORE
  CHANGE_TIME
  CHANGE_BOARD
  CHANGE_SESSION
  CHANGE_DIRECTION
}

enum JOB_STATUS {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum IMPORT_TYPE {
  ATTENDEES
  REGISTRATIONS
  CHECKINS
}

enum EXPORT_TYPE {
  EVENT_REPORT
  ATTENDEE_LIST
  CHECKIN_LOG
  CERTIFICATES
  AUDIT_LOG
}

enum NOTIFICATION_CHANNEL {
  EMAIL
  IN_APP
  WEBHOOK
}

// ── Models ──────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  role         USER_ROLE @default(USER)
  avatarUrl    String?
  passwordHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkins                 CheckinRecord[]
  scannedCheckins          CheckinRecord[]          @relation("CheckinScanner")
  registrations            EventRegistration[]
  createdEvents            Event[]                  @relation("EventCreator")
  ownedWorkspaces          Workspace[]              @relation("WorkspaceCreator")
  workspaceMemberships     WorkspaceMember[]
  workspaceInvitationsSent WorkspaceInvitation[]    @relation("InvitationSender")
  eventAssignments         EventAssignment[]
  eventAssignmentsCreated  EventAssignment[]        @relation("AssignmentCreator")
  notificationPreferences  NotificationPreference[]
  attendanceProofs         AttendanceProof[]

  @@map("users")
}

model Workspace {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String?          @unique
  name        String
  description String?
  logoUrl     String?
  timezone    String           @default("UTC")
  locale      String           @default("en")
  status      WORKSPACE_STATUS @default(ACTIVE)
  createdById String           @db.Uuid
  createdBy   User             @relation("WorkspaceCreator", fields: [createdById], references: [id])
  deletedAt   DateTime?
  purgeAfter  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings                WorkspaceSettings?
  policy                  WorkspacePolicy?
  usage                   WorkspaceUsage?
  members                 WorkspaceMember[]
  invitations             WorkspaceInvitation[]
  events                  Event[]
  auditLogs               AuditLog[]
  importJobs              ImportJob[]
  exportJobs              ExportJob[]
  webhookEndpoints        WebhookEndpoint[]
  CheckinRecord           CheckinRecord[]
  AttendeeFieldDefinition AttendeeFieldDefinition[]
  ConsentPolicy           ConsentPolicy[]
  NotificationPreference  NotificationPreference[]

  @@map("workspaces")
}

model WorkspaceSettings {
  id                         String           @id @default(uuid()) @db.Uuid
  workspaceId                String           @unique @db.Uuid
  workspace                  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  defaultRetentionDays       Int              @default(30)
  allowPublicEventJoin       Boolean          @default(false)
  requireEmailVerification   Boolean          @default(true)
  allowMemberEventView       Boolean          @default(true)
  allowViewerReports         Boolean          @default(false)
  defaultEventVisibility     EVENT_VISIBILITY @default(WORKSPACE)
  defaultQrTtlSeconds        Int              @default(30)
  defaultOfflineGraceSeconds Int              @default(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workspace_settings")
}

model WorkspacePolicy {
  id                           String             @id @default(uuid()) @db.Uuid
  workspaceId                  String             @unique @db.Uuid
  workspace                    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberCanCreateEvents        Boolean            @default(false)
  eventManagerCanInviteScanner Boolean            @default(true)
  eventManagerCanExportReports Boolean            @default(true)
  scannerCanSeeAttendeeList    Boolean            @default(false)
  scannerCanManualCheckin      Boolean            @default(false)
  viewerCanExportReports       Boolean            @default(false)
  requireApprovalForEvents     Boolean            @default(false)
  requireApprovalForImports    Boolean            @default(false)
  requireReasonForManualEdit   Boolean            @default(true)
  dataDeletionMode             DATA_DELETION_MODE @default(ANONYMIZE)
  retentionDays                Int                @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workspace_policies")
}

model WorkspaceUsage {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @unique @db.Uuid
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planKey            String    @default("free_internal")
  maxMembers         Int?
  maxEvents          Int?
  maxAttendees       Int?
  maxMonthlyCheckins Int?
  storageBytes       BigInt    @default(0)
  monthlyCheckins    Int       @default(0)
  monthlyExports     Int       @default(0)
  periodStartedAt    DateTime  @default(now())
  periodEndsAt       DateTime?
  updatedAt          DateTime  @updatedAt

  @@map("workspace_usage")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorUserId String?   @db.Uuid
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model WorkspaceMember {
  id          String                @id @default(uuid()) @db.Uuid
  workspaceId String                @db.Uuid
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String                @db.Uuid
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WORKSPACE_MEMBER_ROLE @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id           String            @id @default(uuid()) @db.Uuid
  workspaceId  String            @db.Uuid
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email        String
  token        String            @unique
  status       INVITATION_STATUS @default(PENDING)
  metadata     Json?
  invitedById  String            @db.Uuid
  invitedBy    User              @relation("InvitationSender", fields: [invitedById], references: [id])
  acceptedById String?           @db.Uuid
  acceptedAt   DateTime?
  expiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, email])
  @@map("workspace_invitations")
}

model Event {
  id                     String            @id @default(uuid()) @db.Uuid
  title                  String
  description            String?
  type                   EVENT_TYPE        @default(SINGLE_SESSION)
  visibility             EVENT_VISIBILITY  @default(WORKSPACE)
  date                   DateTime
  startTime              DateTime
  endTime                DateTime
  startsAt               DateTime?
  endsAt                 DateTime?
  timezone               String?
  location               String
  locationName           String?
  locationAddress        String?
  latitude               Float?
  longitude              Float?
  geofenceRadius         Int?              @default(100) // meters
  status                 EVENT_STATUS      @default(DRAFT)
  capacity               Int?
  waitlistMode           WAITLIST_MODE     @default(DISABLED)
  registrationMode       REGISTRATION_MODE @default(WORKSPACE_MEMBERS)
  registrationOpensAt    DateTime?
  registrationClosesAt   DateTime?
  attendancePolicy       ATTENDANCE_POLICY @default(SINGLE_IN)
  requiredBoardCount     Int?
  joinCode               String            @unique
  publicSlug             String?
  registrationEnabled    Boolean           @default(true)
  allowedDomains         String[]          @default([])
  allowedEmails          String[]          @default([])
  blockedEmails          String[]          @default([])
  checkinModes           CHECKIN_MODE[]    @default([ATTENDEE_CREDENTIAL, BOARD_QR])
  eventQrBehavior        EVENT_QR_BEHAVIOR @default(JOIN_ONLY)
  credentialGraceSeconds Int               @default(120) // 0-300 seconds grace after credential expiry
  workspaceId            String            @db.Uuid
  workspace              Workspace         @relation(fields: [workspaceId], references: [id])

  createdById String    @db.Uuid
  createdBy   User      @relation("EventCreator", fields: [createdById], references: [id])
  deletedAt   DateTime?
  purgeAfter  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings         EventSettings?
  sessions         EventSession[]
  boards           Board[]
  registrations    EventRegistration[]
  checkins         CheckinRecord[]
  assignments      EventAssignment[]
  attendeeFields   AttendeeFieldDefinition[]
  consentPolicies  ConsentPolicy[]
  importJobs       ImportJob[]
  exportJobs       ExportJob[]
  attendanceProofs AttendanceProof[]

  @@index([workspaceId, status, startsAt])
  @@index([workspaceId, publicSlug])
  @@map("events")
}

model EventSettings {
  id                      String            @id @default(uuid()) @db.Uuid
  eventId                 String            @unique @db.Uuid
  event                   Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendancePolicy        ATTENDANCE_POLICY @default(SINGLE_IN)
  requiredBoardCount      Int?
  checkinModes            CHECKIN_MODE[]    @default([ATTENDEE_CREDENTIAL, BOARD_QR])
  eventQrBehavior         EVENT_QR_BEHAVIOR @default(JOIN_ONLY)
  qrTtlSeconds            Int               @default(30)
  credentialGraceSeconds  Int               @default(120)
  offlineSyncEnabled      Boolean           @default(true)
  geofenceEnabled         Boolean           @default(false)
  geofenceRadiusMeters    Int?
  manualCheckinEnabled    Boolean           @default(false)
  manualCorrectionEnabled Boolean           @default(false)
  requireCorrectionReason Boolean           @default(true)
  certificateEnabled      Boolean           @default(false)
  attendanceProofEnabled  Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("event_settings")
}

model EventSession {
  id              String         @id @default(uuid()) @db.Uuid
  eventId         String         @db.Uuid
  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  startsAt        DateTime
  endsAt          DateTime
  locationName    String?
  capacity        Int?
  status          SESSION_STATUS @default(SCHEDULED)
  checkinOpensAt  DateTime?
  checkinClosesAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  boards   Board[]
  checkins CheckinRecord[]

  @@index([eventId, startsAt])
  @@map("event_sessions")
}

model EventAssignment {
  id           String                @id @default(uuid()) @db.Uuid
  eventId      String                @db.Uuid
  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String                @db.Uuid
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         EVENT_ASSIGNMENT_ROLE
  assignedById String                @db.Uuid
  assignedBy   User                  @relation("AssignmentCreator", fields: [assignedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@map("event_assignments")
}

model Board {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  code          String?
  locationName  String?
  eventId       String        @db.Uuid
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessionId     String?       @db.Uuid
  session       EventSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status        BOARD_STATUS  @default(ACTIVE)
  checkinCount  Int           @default(0)
  lastCheckinAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkins CheckinRecord[]

  @@index([eventId, status])
  @@index([sessionId, status])
  @@map("boards")
}

model CheckinRecord {
  id             String            @id @default(uuid()) @db.Uuid
  workspaceId    String?           @db.Uuid
  workspace      Workspace?        @relation(fields: [workspaceId], references: [id])
  userId         String            @db.Uuid
  user           User              @relation(fields: [userId], references: [id])
  eventId        String            @db.Uuid
  event          Event             @relation(fields: [eventId], references: [id])
  sessionId      String?           @db.Uuid
  session        EventSession?     @relation(fields: [sessionId], references: [id])
  boardId        String?           @db.Uuid
  board          Board?            @relation(fields: [boardId], references: [id])
  direction      CHECKIN_DIRECTION @default(IN)
  timestamp      DateTime          @default(now())
  method         CHECKIN_METHOD    @default(QR_SCAN)
  source         CHECKIN_SOURCE    @default(PERSONAL_QR)
  status         CHECKIN_STATUS    @default(VALID)
  scannedById    String?           @db.Uuid
  scannedBy      User?             @relation("CheckinScanner", fields: [scannedById], references: [id])
  deviceId       String?
  latitude       Float?
  longitude      Float?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  idempotencyKey String            @unique

  createdAt DateTime @default(now())

  corrections CheckinCorrection[]

  @@index([userId, eventId])
  @@index([eventId, boardId])
  @@index([workspaceId, eventId, timestamp])
  @@index([eventId, sessionId])
  @@index([boardId, timestamp])
  @@map("checkin_records")
}

model CheckinCorrection {
  id          String                    @id @default(uuid()) @db.Uuid
  checkinId   String                    @db.Uuid
  checkin     CheckinRecord             @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  action      CHECKIN_CORRECTION_ACTION
  reason      String
  before      Json?
  after       Json?
  createdById String                    @db.Uuid
  createdAt   DateTime                  @default(now())

  @@index([checkinId])
  @@map("checkin_corrections")
}

model EventRegistration {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @db.Uuid
  user             User                @relation(fields: [userId], references: [id])
  eventId          String              @db.Uuid
  event            Event               @relation(fields: [eventId], references: [id])
  status           REGISTRATION_STATUS @default(APPROVED)
  source           REGISTRATION_SOURCE @default(SELF_JOIN)
  approvedById     String?             @db.Uuid
  approvedAt       DateTime?
  rejectedReason   String?
  waitlistPosition Int?
  registeredAt     DateTime            @default(now())
  cancelledAt      DateTime?

  fieldValues      RegistrationFieldValue[]
  consents         RegistrationConsent[]
  attendanceProofs AttendanceProof[]

  @@unique([userId, eventId], name: "one_registration_per_event")
  @@index([eventId, status])
  @@map("event_registrations")
}

model AttendeeFieldDefinition {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventId     String?    @db.Uuid
  event       Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  key         String
  label       String
  type        FIELD_TYPE
  required    Boolean    @default(false)
  options     Json?
  validation  Json?
  position    Int        @default(0)
  isArchived  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  values RegistrationFieldValue[]

  @@unique([workspaceId, eventId, key])
  @@index([workspaceId, eventId])
  @@map("attendee_field_definitions")
}

model RegistrationFieldValue {
  id             String                  @id @default(uuid()) @db.Uuid
  registrationId String                  @db.Uuid
  registration   EventRegistration       @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fieldId        String                  @db.Uuid
  field          AttendeeFieldDefinition @relation(fields: [fieldId], references: [id])
  valueText      String?
  valueNumber    Float?
  valueDate      DateTime?
  valueJson      Json?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([registrationId, fieldId])
  @@map("registration_field_values")
}

model ConsentPolicy {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventId     String?   @db.Uuid
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  body        String
  version     Int       @default(1)
  required    Boolean   @default(true)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  consents RegistrationConsent[]

  @@index([workspaceId, eventId])
  @@map("consent_policies")
}

model RegistrationConsent {
  id             String            @id @default(uuid()) @db.Uuid
  registrationId String            @db.Uuid
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  policyId       String            @db.Uuid
  policy         ConsentPolicy     @relation(fields: [policyId], references: [id])
  accepted       Boolean
  acceptedAt     DateTime?
  ipAddress      String?

  @@unique([registrationId, policyId])
  @@map("registration_consents")
}

model AttendanceProof {
  id             String            @id @default(uuid()) @db.Uuid
  registrationId String            @db.Uuid
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  eventId        String            @db.Uuid
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String            @db.Uuid
  user           User              @relation(fields: [userId], references: [id])
  proofCode      String            @unique
  issuedAt       DateTime          @default(now())
  revokedAt      DateTime?
  metadata       Json?

  @@index([eventId, userId])
  @@map("attendance_proofs")
}

model ImportJob {
  id               String      @id @default(uuid()) @db.Uuid
  workspaceId      String      @db.Uuid
  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventId          String?     @db.Uuid
  event            Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type             IMPORT_TYPE
  status           JOB_STATUS  @default(QUEUED)
  fileUrl          String
  originalFileName String?
  mapping          Json?
  summary          Json?
  errorLogUrl      String?
  requestedById    String      @db.Uuid
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime    @default(now())

  @@index([workspaceId, createdAt])
  @@index([eventId, createdAt])
  @@map("import_jobs")
}

model ExportJob {
  id            String      @id @default(uuid()) @db.Uuid
  workspaceId   String      @db.Uuid
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventId       String?     @db.Uuid
  event         Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type          EXPORT_TYPE
  status        JOB_STATUS  @default(QUEUED)
  filters       Json?
  fileUrl       String?
  expiresAt     DateTime?
  summary       Json?
  errorMessage  String?
  requestedById String      @db.Uuid
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime    @default(now())

  @@index([workspaceId, createdAt])
  @@index([eventId, createdAt])
  @@map("export_jobs")
}

model NotificationPreference {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @db.Uuid
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?              @db.Uuid
  workspace   Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel     NOTIFICATION_CHANNEL
  eventType   String
  enabled     Boolean              @default(true)

  @@unique([userId, workspaceId, channel, eventType])
  @@map("notification_preferences")
}

model WebhookEndpoint {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @db.Uuid
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url              String
  secretHash       String
  enabled          Boolean   @default(true)
  subscribedEvents String[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([workspaceId, enabled])
  @@map("webhook_endpoints")
}
